# Copy to .env (same folder as docker-compose.yml), fill in, then: docker compose up -d --build backend
# .env is git-ignored. Never commit real keys.

# resend | smtp | none   (none = automatic email switched off; the app still works)
MAIL_PROVIDER=resend

# Sender address. Must be on a domain you verified with Resend, or the SMTP account's own address.
# Emails show your business name from Settings, e.g. "Sharma Packaging <reminders@yourdomain.in>".
MAIL_FROM=reminders@yourdomain.in

# Resend API key (resend.com -> API Keys). Only needed when MAIL_PROVIDER=resend.
RESEND_API_KEY=

# SMTP account. Only needed when MAIL_PROVIDER=smtp (e.g. Gmail with an app password, Zoho, your host).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Public address of the app, used to build the invoice and pay links in emails.
PUBLIC_BASE_URL=http://localhost:5190

# Read existing paper/PDF invoices from a photo (Google Gemini). Get a key at https://aistudio.google.com/apikey
# The key stays on the server; the browser never sees it. Leave empty to switch the feature off.
AI_API_KEY=
# Any Gemini model that accepts images and PDFs.
AI_MODEL=gemini-flash-latest
